# -------------------------------------------------------------
# ARCHITECT AI — ENVIRONMENT CONFIGURATION
# -------------------------------------------------------------

# Backend Configuration
PROJECT_NAME="Arch_Aware"
API_V1_STR="/api"
# Generate a strong random secret in production
SECRET_KEY="replace-with-cryptographically-random-secret"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS & Reverse Proxy Trust
NIVORA_CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
# JSON array or comma-separated list of trusted proxy IPs/CIDRs behind a reverse proxy
TRUSTED_PROXIES="[]"

# Database (SQLite local dev or persistent mount path e.g. sqlite:////var/data/architect_ai.db)
DATABASE_URL="sqlite:///./architect_ai.db"

# Demo Mode (False recommended for production)
DEMO_MODE=True

# Sourcing Defaults
DEFAULT_SEARCH_RADIUS_KM=25.0
FALLBACK_RADIUS_LEVEL_1_KM=50.0
FALLBACK_RADIUS_LEVEL_2_KM=100.0

# External API Integrations (All Secrets Kept Out of Git & Frontend)
# 1. SocialCrawl API (Powers Pinterest, Instagram, YouTube SocialCrawl-only, Reddit, and Google Shopping)
SOCIALCRAWL_API_KEY=""

# 2. Google Places API New (For live supplier & showroom discovery)
GOOGLE_PLACES_API_KEY=""

# 3. Google Programmable Search Engine (General Web Search; both key and CX are required)
# Accepted aliases: CUSTOM_SEARCH_API_KEY / GOOGLE_CUSTOM_SEARCH_API_KEY and CUSTOM_SEARCH_CX / GOOGLE_CUSTOM_SEARCH_CX
GOOGLE_CUSTOM_SEARCH_API_KEY=""
GOOGLE_CUSTOM_SEARCH_CX=""

# 4. LLM API (For AI Material Identification & search interpretation)
GEMINI_API_KEY=""

# Frontend Build-Time API URL (must include /api)
NEXT_PUBLIC_API_URL="http://127.0.0.1:8000/api"
